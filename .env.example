# LLM providers (optional — local classifier works without these)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Postgres
# Local dev (Docker — npm run db:up):
DATABASE_URL=postgresql://ycscrape:ycscrape@localhost:5432/ycscrape
# Production (Supabase — Settings → Database → URI, add ?sslmode=require):
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# API server (Railway sets PORT automatically)
GENERATOR_API_PORT=3456

# Rate limits (per IP per minute; localhost exempt; optional on Railway)
# RATE_LIMIT_DISABLED=1
# RATE_LIMIT_BUNDLE_MAX=30
# RATE_LIMIT_READ_MAX=120
# RATE_LIMIT_WRITE_MAX=40
# RATE_LIMIT_EXPENSIVE_MAX=12

# Explorer production build (Vercel — Railway API URL, no trailing slash)
# VITE_API_URL=https://your-app.up.railway.app

# Playwright browser cache (local scrape)
PLAYWRIGHT_BROWSERS_PATH=./.playwright-browsers
