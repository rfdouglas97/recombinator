{
  "name": "recombinator",
  "version": "1.0.0",
  "description": "Scrapes the Y Combinator startup directory, classifies companies into a business-model x vertical taxonomy with an LLM audit pass, and surfaces market whitespace through a React explorer and idea generator.",
  "type": "module",
  "license": "MIT",
  "author": "Ryan Douglas",
  "repository": {
    "type": "git",
    "url": "https://github.com/rfdouglas97/recombinator.git"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "y-combinator",
    "startup-data",
    "web-scraping",
    "playwright",
    "taxonomy",
    "llm",
    "classification",
    "market-research"
  ],
  "scripts": {
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "scrape": "node scrape.mjs",
    "scrape:test": "node scrape.mjs --limit 10",
    "classify": "node classify.mjs",
    "classify:pilot": "node classify.mjs --limit 20 --out output/yc_classified_pilot.json",
    "classify:pending": "node classify.mjs --pending",
    "phenotype-agent": "node agent/run.mjs --mode anthropic --concurrency 8",
    "phenotype-agent:resume": "node agent/run.mjs --mode anthropic --resume",
    "phenotype-agent:local": "node agent/run.mjs --mode local",
    "phenotype-agent:test": "node agent/run.mjs --mode anthropic --fresh --limit 3",
    "verticals:emit": "node taxonomy/verticals.mjs --emit-json",
    "verticals:list": "node normalize-verticals.mjs --list-verticals",
    "verticals:normalize": "node normalize-verticals.mjs --write",
    "verticals:refine-archetypes": "node normalize-verticals.mjs --write && npm run whitespace:rank",
    "verticals:gaps": "node normalize-verticals.mjs --gaps --write",
    "verticals:classify": "node agent/classify-verticals.mjs --fresh",
    "verticals:classify:resume": "node agent/classify-verticals.mjs --resume",
    "verticals:classify:test": "node agent/classify-verticals.mjs --fresh --limit 5",
    "verticals:expand": "node agent/expand-verticals.mjs",
    "verticals:expand:resume": "node agent/expand-verticals.mjs --resume",
    "verticals:merge": "node taxonomy/merge-verticals.mjs",
    "verticals:audit": "node scripts/build-vertical-audit.mjs",
    "verticals:expand-all": "node agent/expand-verticals.mjs && node scripts/build-vertical-audit.mjs",
    "phenotype:rebuild": "node scripts/rebuild-assignments.mjs",
    "audit:refine": "node scripts/apply-archetype-refinement.mjs",
    "audit:tiered": "node agent/tiered-audit.mjs && node scripts/build-classification-audit-review.mjs",
    "audit:tiered:test": "node agent/tiered-audit.mjs --fresh --limit 10 && node scripts/build-classification-audit-review.mjs",
    "audit:classifications": "node agent/audit-classifications.mjs && node scripts/build-classification-audit-review.mjs",
    "audit:classifications:resume": "node agent/audit-classifications.mjs --resume && node scripts/build-classification-audit-review.mjs",
    "audit:classifications:test": "node agent/audit-classifications.mjs --fresh --limit 5 && node scripts/build-classification-audit-review.mjs",
    "audit:classifications:full": "node agent/audit-classifications.mjs --fresh && node scripts/build-classification-audit-review.mjs",
    "audit:review": "node scripts/build-classification-audit-review.mjs",
    "audit:reclassify": "node agent/reclassify-classifications.mjs",
    "audit:reclassify:resume": "node agent/reclassify-classifications.mjs --resume",
    "audit:reclassify:test": "node agent/reclassify-classifications.mjs --fresh --limit 5",
    "audit:reclassify:all": "node agent/reclassify-classifications.mjs --fresh --all",
    "audit:fix": "node agent/reclassify-classifications.mjs --fresh && node scripts/build-classification-audit-review.mjs",
    "audit:pipeline": "npm run audit:classifications:full && npm run audit:reclassify && npm run audit:human-queue && npm run audit:review",
    "audit:fix-all": "node agent/reclassify-classifications.mjs --fresh --concurrency 4 && node agent/audit-classifications.mjs --fresh && node scripts/build-human-correction-queue.mjs && node scripts/build-classification-audit-review.mjs",
    "audit:human-queue": "node scripts/build-human-correction-queue.mjs",
    "data:bundle": "node scripts/build-explorer-data.mjs",
    "launches:scrape": "node scripts/scrape-launches.mjs",
    "launches:check": "node scripts/check-launches.mjs",
    "launches:check:ingest": "node scripts/check-launches.mjs --ingest --ingest-new --refresh",
    "corpus:restore": "node scripts/restore-scrape-corpus.mjs",
    "corpus:promote": "node scripts/check-launches.mjs --promote",
    "launches:check:cache": "node scripts/check-launches.mjs --from-cache",
    "launches:daily": "bash scripts/run-daily-launch-check.sh",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:psql": "docker compose exec postgres psql -U ycscrape -d ycscrape",
    "db:migrate": "node db/migrate-from-json.mjs",
    "db:migrate:dry": "node db/migrate-from-json.mjs --dry-run",
    "db:ping": "node db/ping.mjs",
    "api:dev": "node server/generator-api.mjs",
    "api:read": "node server/generator-api.mjs",
    "generator:api": "node server/generator-api.mjs",
    "generator:primitives": "node scripts/build-idea-primitives.mjs",
    "whitespace:rank": "node whitespace/build.mjs",
    "whitespace:refresh": "npm run verticals:gaps && npm run generator:primitives && npm run whitespace:rank",
    "startup-engine": "node startup_engine/run.mjs",
    "startup-engine:pick": "node startup_engine/run.mjs pick",
    "startup-engine:refresh": "npm run whitespace:refresh",
    "startup-library": "node startup_engine/run.mjs",
    "startup-library:pick": "node startup_engine/run.mjs pick",
    "startup-library:refresh": "npm run startup-engine:refresh",
    "explorer:dev": "npm run data:bundle && node scripts/dev-explorer.mjs",
    "explorer:dev:vite": "npm run data:bundle && cd explorer && npm run dev",
    "explorer:build": "npm run data:bundle && cd explorer && npm install && npm run build",
    "postinstall": "node -e \"console.log('Run: export PLAYWRIGHT_BROWSERS_PATH=\\\"$(pwd)/.playwright-browsers\\\" && npx playwright install chromium')\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "pg": "^8.21.0",
    "playwright": "^1.60.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "typescript-eslint": "^8.61.0"
  }
}
